<UserControl x:Class="WattPunktAdmin.Widoki.SesjeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel Margin="10">
        <Expander DockPanel.Dock="Top" Header="Wyszukiwanie i filtry" IsExpanded="True">
            <WrapPanel>
                <HeaderedContentControl Header="Od dnia" Style="{StaticResource Filtr}">
                    <DatePicker SelectedDate="{Binding Od}" Style="{StaticResource PoleFiltra}" Width="140" MinWidth="0" AutomationProperties.AutomationId="SesjeOd" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Do dnia" Style="{StaticResource Filtr}">
                    <DatePicker SelectedDate="{Binding Do}" Style="{StaticResource PoleFiltra}" Width="140" MinWidth="0" AutomationProperties.AutomationId="SesjeDo" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Stacja" Style="{StaticResource Filtr}">
                    <ComboBox ItemsSource="{Binding StacjeFiltra}" SelectedItem="{Binding StacjaFiltra}" Style="{StaticResource PoleFiltra}" Width="190" AutomationProperties.AutomationId="SesjeStacja" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Klasa mocy" Style="{StaticResource Filtr}">
                    <ComboBox ItemsSource="{Binding KlasyMocy}" SelectedItem="{Binding Klasa}" Style="{StaticResource PoleFiltra}" MinWidth="100" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Status sesji" Style="{StaticResource Filtr}">
                    <ComboBox ItemsSource="{Binding Statusy}" SelectedItem="{Binding Status}" Style="{StaticResource PoleFiltra}" Width="160" />
                </HeaderedContentControl>
                <HeaderedContentControl Header="Nr sesji, klient lub ładowarka" Style="{StaticResource Filtr}">
                    <TextBox Text="{Binding Szukaj, UpdateSourceTrigger=PropertyChanged}" Width="170" Style="{StaticResource PoleFiltra}"
                             ToolTip="Numer sesji, numer klienta, nazwa klienta albo numer seryjny ładowarki">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding SzukajCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                </HeaderedContentControl>
                <StackPanel Style="{StaticResource PrzyciskiFiltra}">
                    <Button Content="Szukaj" Style="{StaticResource PrzyciskGlowny}" Command="{Binding SzukajCommand}" AutomationProperties.AutomationId="SzukajSesji" />
                    <Button Content="Wyczyść filtry" Command="{Binding WyczyscFiltrCommand}" />
                </StackPanel>
            </WrapPanel>
        </Expander>

        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="{StaticResource Ramka}" BorderThickness="1" Padding="8,6" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="‹ Poprzednia" Command="{Binding PoprzedniaCommand}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding OpisStrony}" VerticalAlignment="Center" Margin="0,0,8,0" MinWidth="110" TextAlignment="Center" />
                    <Button Content="Następna ›" Command="{Binding NastepnaCommand}" Margin="0" AutomationProperties.AutomationId="NastepnaStrona" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center">
                    <Run Text="Sesji: " /><Run Text="{Binding LiczbaWynikow, StringFormat=N0, Mode=OneWay}" FontWeight="SemiBold" />
                    <Run Text="   Energia: " /><Run Text="{Binding SumaEnergii, StringFormat=N0, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" kWh" />
                    <Run Text="   Przychód: " /><Run Text="{Binding SumaPrzychodu, StringFormat=N2, Mode=OneWay}" FontWeight="SemiBold" /><Run Text=" zł" />
                </TextBlock>
            </DockPanel>
        </Border>

        <DataGrid ItemsSource="{Binding Sesje}" AutomationProperties.AutomationId="ListaSesji">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Nr sesji" Binding="{Binding SesjaID}" Width="70" ElementStyle="{StaticResource KomorkaLiczby}" />
                <DataGridTextColumn Header="Start" Binding="{Binding Start, StringFormat=dd.MM.yyyy HH:mm}" Width="115" />
                <DataGridTextColumn Header="Stacja" Binding="{Binding Stacja}" Width="*" />
                <DataGridTextColumn Header="Ładowarka" Binding="{Binding Ladowarka}" Width="110" />
                <DataGridTextColumn Header="Klasa" Binding="{Binding KlasaMocy}" Width="50" />
                <DataGridTextColumn Header="Klient" Binding="{Binding Klient}" Width="*" />
                <DataGridTextColumn Header="kWh" Binding="{Binding EnergiaKWh, StringFormat=N2}" Width="65" ElementStyle="{StaticResource KomorkaLiczby}" />
                <DataGridTextColumn Header="Minuty" Binding="{Binding CzasMin}" Width="60" ElementStyle="{StaticResource KomorkaLiczby}" />
                <DataGridTextColumn Header="Kwota zł" Binding="{Binding KwotaRazem, StringFormat=N2}" Width="75" ElementStyle="{StaticResource KomorkaLiczby}" />
                <DataGridTextColumn Header="Płatność" Binding="{Binding MetodaPlatnosci}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160" />
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</UserControl>

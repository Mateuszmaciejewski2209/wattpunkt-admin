<Window x:Class="WattPunktAdmin.Widoki.LogowanieWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:WattPunktAdmin.Widoki"
        Title="WattPunkt Admin: logowanie" Width="430" SizeToContent="Height"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="{StaticResource Tlo}"
        FocusManager.FocusedElement="{Binding ElementName=poleLogin}">
    <StackPanel>
        <Border Background="{StaticResource Glowny}" Padding="24,18">
            <StackPanel>
                <TextBlock Text="WattPunkt Admin" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Obsługa sieci stacji ładowania" Foreground="{StaticResource GlownyJasny}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>
        <StackPanel Margin="24,18,24,20">
            <TextBlock Text="Login" Style="{StaticResource Etykieta}" Margin="0,0,0,2" />
            <TextBox x:Name="poleLogin" AutomationProperties.AutomationId="Login"
                     Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />
            <TextBlock Text="Hasło" Style="{StaticResource Etykieta}" Margin="0,0,0,2" />
            <PasswordBox AutomationProperties.AutomationId="Haslo" Margin="0,0,0,14"
                         w:PasswordBoxPomocnik.Wlacz="True"
                         w:PasswordBoxPomocnik.Haslo="{Binding Haslo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <Button Content="Zaloguj" Style="{StaticResource PrzyciskGlowny}" IsDefault="True" Margin="0"
                    AutomationProperties.AutomationId="Zaloguj" Command="{Binding ZalogujCommand}" HorizontalAlignment="Stretch" Padding="0,8" />
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,10,0,0"
                         Visibility="{Binding Trwa, Converter={StaticResource BoolNaWidocznosc}}" />
            <TextBlock Text="{Binding Komunikat}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{StaticResource Blad}"
                       AutomationProperties.AutomationId="Komunikat" />
        </StackPanel>
    </StackPanel>
</Window>

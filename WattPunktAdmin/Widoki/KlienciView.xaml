<UserControl x:Class="WattPunktAdmin.Widoki.KlienciView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="430" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,10,0">
            <Expander DockPanel.Dock="Top" Header="Wyszukiwanie i filtry" IsExpanded="True">
                <WrapPanel>
                    <HeaderedContentControl Header="Nazwa, miejscowość lub numer" Style="{StaticResource Filtr}">
                        <TextBox Text="{Binding Szukaj, UpdateSourceTrigger=PropertyChanged}" Width="200" Style="{StaticResource PoleFiltra}"
                                 ToolTip="Nazwisko, nazwa firmy, miejscowość albo numer klienta" AutomationProperties.AutomationId="SzukajKlienta">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SzukajCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Typ klienta" Style="{StaticResource Filtr}">
                        <ComboBox ItemsSource="{Binding TypyFiltra}" SelectedItem="{Binding Typ}" Style="{StaticResource PoleFiltra}" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Plan taryfowy" Style="{StaticResource Filtr}">
                        <ComboBox ItemsSource="{Binding PlanyFiltra}" SelectedItem="{Binding PlanFiltra}" Style="{StaticResource PoleFiltra}" MinWidth="110" />
                    </HeaderedContentControl>
                    <StackPanel Style="{StaticResource PrzyciskiFiltra}">
                        <Button Content="Szukaj" Style="{StaticResource PrzyciskGlowny}" Command="{Binding SzukajCommand}" AutomationProperties.AutomationId="SzukajKlientow" />
                    </StackPanel>
                </WrapPanel>
            </Expander>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding InformacjaOLiscie}" Foreground="{StaticResource TekstSzary}" Margin="0,6,0,0" />
            <DataGrid ItemsSource="{Binding Klienci}" SelectedItem="{Binding Wybrany}" AutomationProperties.AutomationId="ListaKlientow">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nr" Binding="{Binding KlientID}" Width="55" ElementStyle="{StaticResource KomorkaLiczby}" />
                    <DataGridTextColumn Header="Nazwa" Binding="{Binding Nazwa}" Width="2*" />
                    <DataGridTextColumn Header="Typ" Binding="{Binding TypKlienta}" Width="90" />
                    <DataGridTextColumn Header="Miejscowość" Binding="{Binding Miejscowosc}" Width="*" />
                    <DataGridTextColumn Header="Plan" Binding="{Binding Plan}" Width="60" />
                    <DataGridTextColumn Header="Rejestracja" Binding="{Binding DataRejestracji, StringFormat=dd.MM.yyyy}" Width="85" />
                    <DataGridTextColumn Header="Pojazdy" Binding="{Binding LiczbaPojazdow}" Width="65" ElementStyle="{StaticResource KomorkaLiczby}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <ScrollViewer Grid.Column="1" Focusable="False" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="{Binding Formularz.Tytul}">
                    <StackPanel>
                        <Grid DataContext="{Binding Formularz}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Typ klienta" Style="{StaticResource Etykieta}" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,8">
                                <RadioButton Content="indywidualny" GroupName="typKlienta" Margin="0,0,16,0"
                                             IsChecked="{Binding TypKlienta, Converter={StaticResource RownaSie}, ConverterParameter=indywidualny}" />
                                <RadioButton Content="firmowy" GroupName="typKlienta"
                                             IsChecked="{Binding TypKlienta, Converter={StaticResource RownaSie}, ConverterParameter=firmowy}" />
                            </StackPanel>
                            <TextBlock Grid.Row="1" Text="Nazwa" Style="{StaticResource Etykieta}" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Nazwa, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.AutomationId="NazwaKlienta" />
                            <TextBlock Grid.Row="2" Text="Miejscowość" Style="{StaticResource Etykieta}" />
                            <ComboBox Grid.Row="2" Grid.Column="1" SelectedItem="{Binding Miejscowosc}" AutomationProperties.AutomationId="MiejscowoscKlienta"
                                      ItemsSource="{Binding DataContext.Miejscowosci, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBlock Grid.Row="3" Text="Plan taryfowy" Style="{StaticResource Etykieta}" />
                            <ComboBox Grid.Row="3" Grid.Column="1" SelectedItem="{Binding Plan}" AutomationProperties.AutomationId="PlanKlienta"
                                      ItemsSource="{Binding DataContext.Plany, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Nazwa, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " />
                                            <Run Text="{Binding Opis, Mode=OneWay}" Foreground="{StaticResource TekstSzary}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Grid.Row="4" Text="Data rejestracji" Style="{StaticResource Etykieta}" />
                            <DatePicker Grid.Row="4" Grid.Column="1" SelectedDate="{Binding DataRejestracji}" IsEnabled="{Binding CzyNowy}" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Formularz.WszystkieBledy}" ItemTemplate="{StaticResource ListaBledow}" Margin="0,0,0,6" />
                        <WrapPanel>
                            <Button Content="Nowy klient" Command="{Binding NowyCommand}" />
                            <Button Content="Zapisz" Style="{StaticResource PrzyciskGlowny}" Command="{Binding ZapiszCommand}" AutomationProperties.AutomationId="ZapiszKlienta" />
                            <Button Content="Anuluj" Command="{Binding AnulujCommand}" />
                            <Button Content="Usuń" Style="{StaticResource PrzyciskUsun}" Command="{Binding UsunCommand}"
                                    Visibility="{Binding MozeUsuwac, Converter={StaticResource BoolNaWidocznosc}}" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Pojazdy klienta" Margin="0,8,0,0" IsEnabled="{Binding Wybrany, Converter={StaticResource NieNull}}">
                    <StackPanel>
                        <DataGrid ItemsSource="{Binding Pojazdy}" SelectedItem="{Binding WybranyPojazd}" MaxHeight="170">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="*" />
                                <DataGridTextColumn Header="Rok" Binding="{Binding RokProdukcji}" Width="50" />
                                <DataGridTextColumn Header="Dodany" Binding="{Binding DataDodania, StringFormat=dd.MM.yyyy}" Width="80" />
                                <DataGridTextColumn Header="Sesje" Binding="{Binding LiczbaSesji}" Width="55" ElementStyle="{StaticResource KomorkaLiczby}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Margin="0,8,0,0" DataContext="{Binding Pojazd}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="80" />
                            </Grid.ColumnDefinitions>
                            <ComboBox SelectedItem="{Binding Model}" ToolTip="Model pojazdu" AutomationProperties.AutomationId="ModelPojazdu"
                                      ItemsSource="{Binding DataContext.ModelePojazdow, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            <TextBox Grid.Column="1" Text="{Binding RokProdukcji, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" ToolTip="Rok produkcji" AutomationProperties.AutomationId="RokPojazdu" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding Pojazd.WszystkieBledy}" ItemTemplate="{StaticResource ListaBledow}" />
                        <WrapPanel>
                            <Button Content="Dodaj pojazd" Command="{Binding DodajPojazdCommand}" AutomationProperties.AutomationId="DodajPojazd" />
                            <Button Content="Usuń pojazd" Style="{StaticResource PrzyciskUsun}" Command="{Binding UsunPojazdCommand}"
                                    Visibility="{Binding MozeUsuwac, Converter={StaticResource BoolNaWidocznosc}}" />
                        </WrapPanel>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Historia planów taryfowych" Margin="0,8,0,0">
                    <ListBox ItemsSource="{Binding HistoriaPlanow}" BorderThickness="0" MaxHeight="140">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding Plan, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="   " />
                                    <Run Text="{Binding Okres, Mode=OneWay}" Foreground="{StaticResource TekstSzary}" />
                                </TextBlock>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

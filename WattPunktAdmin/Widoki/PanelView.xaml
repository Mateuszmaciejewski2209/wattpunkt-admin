<UserControl x:Class="WattPunktAdmin.Widoki.PanelView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="18">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Odśwież" Command="{Binding OdswiezCommand}" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Powitanie}" Style="{StaticResource Naglowek}" />
            </DockPanel>

            <UniformGrid Columns="4">
                <Border Style="{StaticResource Kafel}">
                    <StackPanel>
                        <TextBlock Text="Stacje ładowania" Style="{StaticResource KafelOpis}" />
                        <TextBlock Text="{Binding Dane.LiczbaStacji}" Style="{StaticResource KafelLiczba}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kafel}">
                    <StackPanel>
                        <TextBlock Text="Ładowarki" Style="{StaticResource KafelOpis}" />
                        <TextBlock Text="{Binding Dane.LiczbaLadowarek}" Style="{StaticResource KafelLiczba}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kafel}">
                    <StackPanel>
                        <TextBlock Text="Klienci z kontem" Style="{StaticResource KafelOpis}" />
                        <TextBlock Text="{Binding Dane.LiczbaKlientow, StringFormat=N0}" Style="{StaticResource KafelLiczba}" />
                    </StackPanel>
                </Border>
                <Border Margin="0,0,0,12">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Kafel}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Dane.OtwarteAwarie}" Value="0">
                                    <Setter Property="Background" Value="{StaticResource GlownyJasny}" />
                                </DataTrigger>
                            </Style.Triggers>
                            <Setter Property="Background" Value="{StaticResource BladJasny}" />
                        </Style>
                    </Border.Style>
                    <StackPanel>
                        <TextBlock Text="Otwarte awarie" Style="{StaticResource KafelOpis}" />
                        <TextBlock Text="{Binding Dane.OtwarteAwarie}" Style="{StaticResource KafelLiczba}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <TextBlock Style="{StaticResource Podnaglowek}">
                <Run Text="Ostatni miesiąc z danymi o sesjach: " /><Run Text="{Binding Dane.OkresDanych, Mode=OneWay}" />
            </TextBlock>
            <UniformGrid Columns="3">
                <Border Style="{StaticResource Kafel}">
                    <StackPanel>
                        <TextBlock Text="Sesje ładowania" Style="{StaticResource KafelOpis}" />
                        <TextBlock Text="{Binding Dane.SesjeMiesiac, StringFormat=N0}" Style="{StaticResource KafelLiczba}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kafel}">
                    <StackPanel>
                        <TextBlock Text="Sprzedana energia (kWh)" Style="{StaticResource KafelOpis}" />
                        <TextBlock Text="{Binding Dane.EnergiaMiesiac, StringFormat=N0}" Style="{StaticResource KafelLiczba}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Kafel}" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="Przychód (zł)" Style="{StaticResource KafelOpis}" />
                        <TextBlock Text="{Binding Dane.PrzychodMiesiac, StringFormat=N2}" Style="{StaticResource KafelLiczba}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="2*" />
                </Grid.ColumnDefinitions>
                <GroupBox Header="Stacje z największym przychodem w tym miesiącu" Margin="0,0,12,0">
                    <ListView ItemsSource="{Binding NajlepszeStacje}" BorderThickness="0">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Stacja" Width="220" DisplayMemberBinding="{Binding Stacja}" />
                                <GridViewColumn Header="Sesje" Width="70">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Sesje, StringFormat=N0}" HorizontalAlignment="Right" /></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Przychód (zł)" Width="110">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Przychod, StringFormat=N2}" HorizontalAlignment="Right" /></DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Udział w przychodzie" Width="190">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid Width="170">
                                                <ProgressBar Value="{Binding Udzial, Mode=OneWay}" Maximum="10" Height="14"
                                                             Foreground="{StaticResource Glowny}" Background="{StaticResource GlownyJasny}" />
                                                <TextBlock Text="{Binding Udzial, StringFormat={}{0:N1}%}" HorizontalAlignment="Center" FontSize="11" />
                                            </Grid>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </GroupBox>
                <GroupBox Grid.Column="1" Header="Ostatnie zgłoszenia awarii">
                    <ItemsControl ItemsSource="{Binding OstatnieAwarie}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource Ramka}" BorderThickness="0,0,0,1" Padding="0,6">
                                    <StackPanel>
                                        <TextBlock FontWeight="SemiBold">
                                            <Run Text="{Binding NumerSeryjny, Mode=OneWay}" /><Run Text=" na stacji " /><Run Text="{Binding Stacja, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Foreground="{StaticResource TekstSzary}">
                                            <Run Text="{Binding Kategoria, Mode=OneWay}" /><Run Text=", " />
                                            <Run Text="{Binding Poczatek, StringFormat={}{0:dd.MM.yyyy HH:mm}, Mode=OneWay}" /><Run Text=", naprawa: " />
                                            <Run Text="{Binding CzasNaprawy, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </GroupBox>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

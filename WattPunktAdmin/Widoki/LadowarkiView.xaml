<UserControl x:Class="WattPunktAdmin.Widoki.LadowarkiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="400" />
        </Grid.ColumnDefinitions>

        <DockPanel Margin="0,0,10,0">
            <Expander DockPanel.Dock="Top" Header="Wyszukiwanie i filtry" IsExpanded="True">
                <WrapPanel>
                    <HeaderedContentControl Header="Numer seryjny, stacja, producent" Style="{StaticResource Filtr}">
                        <TextBox Text="{Binding Szukaj, UpdateSourceTrigger=PropertyChanged}" Width="190" Style="{StaticResource PoleFiltra}"
                                 ToolTip="Wpisz fragment i naciśnij Enter">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SzukajCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Stacja" Style="{StaticResource Filtr}">
                        <ComboBox ItemsSource="{Binding StacjeFiltra}" SelectedItem="{Binding StacjaFiltra}" Style="{StaticResource PoleFiltra}" Width="220" AutomationProperties.AutomationId="LadowarkiStacjaFiltr" />
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Klasa mocy" Style="{StaticResource Filtr}">
                        <ComboBox ItemsSource="{Binding KlasyMocy}" SelectedItem="{Binding Klasa}" Style="{StaticResource PoleFiltra}" MinWidth="100" />
                    </HeaderedContentControl>
                    <StackPanel Style="{StaticResource PrzyciskiFiltra}">
                        <Button Content="Szukaj" Style="{StaticResource PrzyciskGlowny}" Command="{Binding SzukajCommand}" />
                    </StackPanel>
                </WrapPanel>
            </Expander>
            <DataGrid ItemsSource="{Binding Ladowarki}" SelectedItem="{Binding Wybrana}" AutomationProperties.AutomationId="ListaLadowarek">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding AwariaOtwarta}" Value="True">
                                <Setter Property="Background" Value="{StaticResource BladJasny}" />
                                <Setter Property="ToolTip" Value="Ładowarka ma otwartą awarię" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Numer seryjny" Binding="{Binding NumerSeryjny}" Width="130" />
                    <DataGridTextColumn Header="Stacja" Binding="{Binding Stacja}" Width="3*" />
                    <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="2*" />
                    <DataGridTextColumn Header="Moc kW" Binding="{Binding MocKW}" Width="65" ElementStyle="{StaticResource KomorkaLiczby}" />
                    <DataGridTextColumn Header="Klasa" Binding="{Binding KlasaMocy}" Width="50" />
                    <DataGridTextColumn Header="Instalacja" Binding="{Binding DataInstalacji, StringFormat=dd.MM.yyyy}" Width="85" />
                    <DataGridTextColumn Header="Awarie" Binding="{Binding LiczbaAwarii}" Width="60" ElementStyle="{StaticResource KomorkaLiczby}" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <GroupBox Grid.Column="1" Header="{Binding Formularz.Tytul}">
            <StackPanel>
                <TextBlock Text="Edycja ładowarek jest dostępna tylko dla administratora." Foreground="{StaticResource TekstSzary}"
                           TextWrapping="Wrap" Margin="0,0,0,8"
                           Visibility="{Binding MozeEdytowac, Converter={StaticResource BoolNaWidocznoscOdwrotny}}" />
                <Grid IsEnabled="{Binding DataContext.MozeEdytowac, RelativeSource={RelativeSource AncestorType=UserControl}}" DataContext="{Binding Formularz}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Stacja" Style="{StaticResource Etykieta}" />
                    <ComboBox Grid.Column="1" SelectedItem="{Binding Stacja}"
                              ItemsSource="{Binding DataContext.Stacje, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Grid.Row="1" Text="Model" Style="{StaticResource Etykieta}" />
                    <ComboBox Grid.Row="1" Grid.Column="1" SelectedItem="{Binding Model}"
                              ItemsSource="{Binding DataContext.Modele, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Grid.Row="2" Text="Numer seryjny" Style="{StaticResource Etykieta}" />
                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding NumerSeryjny, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper" MaxLength="20" />
                    <TextBlock Grid.Row="3" Text="Data instalacji" Style="{StaticResource Etykieta}" />
                    <DatePicker Grid.Row="3" Grid.Column="1" SelectedDate="{Binding DataInstalacji}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Formularz.WszystkieBledy}" ItemTemplate="{StaticResource ListaBledow}" Margin="0,0,0,6" />
                <WrapPanel Visibility="{Binding MozeEdytowac, Converter={StaticResource BoolNaWidocznosc}}">
                    <Button Content="Nowa ładowarka" Command="{Binding NowaCommand}" />
                    <Button Content="Zapisz" Style="{StaticResource PrzyciskGlowny}" Command="{Binding ZapiszCommand}" />
                    <Button Content="Anuluj" Command="{Binding AnulujCommand}" />
                    <Button Content="Usuń" Style="{StaticResource PrzyciskUsun}" Command="{Binding UsunCommand}"
                            Visibility="{Binding MozeUsuwac, Converter={StaticResource BoolNaWidocznosc}}" />
                </WrapPanel>
                <Button Content="Zgłoś awarię tej ładowarki" Command="{Binding ZglosAwarieCommand}" HorizontalAlignment="Left"
                        Margin="0,6,0,0" AutomationProperties.AutomationId="ZglosAwarieLadowarki" ToolTipService.ShowOnDisabled="True"
                        ToolTip="Otwiera zakładkę Awarie z wybraną ładowarką. Ładowarka może mieć tylko jedną otwartą awarię." />
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TekstSzary}" Margin="0,10,0,0"
                           Text="Wiersze na czerwonym tle to ładowarki z otwartą awarią. Ładowarki z historią sesji lub awarii nie można usunąć." />
            </StackPanel>
        </GroupBox>
    </Grid>
</UserControl>
